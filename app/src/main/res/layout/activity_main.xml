<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fh_bg"
    android:orientation="vertical">

    <!-- Native status-bar color backdrop; triple-tap opens Server Manager without taking extra chrome. -->
    <View
        android:id="@+id/statusBarScrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/fh_bg" />

    <FrameLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/fh_bg" />

        <ProgressBar
            android:id="@+id/loadingBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="top"
            android:indeterminate="false"
            android:max="100"
            android:progressTint="@color/fh_accent"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/errorOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/fh_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/errorTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/error_title"
                android:textColor="@color/fh_fg"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/errorDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/fh_dim"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/retryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/error_retry" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/switchServerButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/error_switch_server" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Native bottom navigation bar color backdrop (collapses when IME is visible). -->
    <View
        android:id="@+id/navBarScrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/fh_bg" />
</LinearLayout>
